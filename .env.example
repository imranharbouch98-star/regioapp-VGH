# ---- Firebase (gedeelde database + inloggen) ----
# Uit Firebase Console -> Project settings -> Your apps -> Web app.
# Zodra deze ingevuld zijn, controleert Firebase de codes en zien alle
# gebruikers elkaars aanpassingen live.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# De twee gedeelde accounts (Firebase Console -> Authentication -> Users).
# Het wachtwoord van elk account IS de code die je op het loginscherm typt.
# Pas je het beheerder-adres aan, pas het dan ook aan in database.rules.json.
VITE_FIREBASE_VIEWER_EMAIL=viewer@vgh.local
VITE_FIREBASE_ADMIN_EMAIL=admin@vgh.local

# ---- Enkel voor lokaal testen ZONDER Firebase ----
# Genegeerd zodra Firebase hierboven ingevuld is.
VITE_ACCESS_CODE=
VITE_ADMIN_ACCESS_CODE=
